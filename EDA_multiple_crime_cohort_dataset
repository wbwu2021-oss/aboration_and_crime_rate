proc sql noprint;
  select min(year), max(year) into :firstcrime trimmed, :lastcrime trimmed
  from crimes_clean;
quit;
%let maxlag = 20;


/* cohort lags from 0-20 years in 4 states, CA, TX, AL, NY. Two states with legalized abortion and two states
with illegal abortion. Showing negative correlation for abortion and total crime/violent crime with slightly 
significant p-values */


/* use this data set for modeling, can convert to different languages if you prefer them */
data work.merged_states;
  set merged_all_lags;
  where state in ('CA','TX','AL','NY')
    and missing_abortion = 0 and missing_crime = 0
    and cohort_year >= &firstcrime
    and cohort_year <= &lastcrime - &maxlag;   /* same cohorts at every lag */
  rename 'Data.Rates.Property.All'n = prop_rate
         'Data.Rates.Violent.All'n  = viol_rate;
run;

data work.merged_states;
  set merged_all_lags;
  where state in ('CA','TX','AL','NY')
    and missing_abortion = 0 and missing_crime = 0;
   violent_rate  = input(compress('Data.Rates.Violent.All'n,  ','), ?? best32.);
  property_rate = input(compress('Data.Rates.Property.All'n, ','), ?? best32.);

  drop 'Data.Rates.Violent.All'n 'Data.Rates.Property.All'n;

 
  if population1544 > 0 then do;
    birthrate_100k     = birthstotal      / population1544 * 100000;
    pregnancyrate_100k = pregnanciestotal / population1544 * 100000;
  end;
run;

proc means data= work.merged_states mean min max maxdec=1;
  var abortionratetotal_100k birthratetotal birthrate_100k
      pregnancyratetotal pregnancyrate_100k
      total_crime_rate violent_rate property_rate;
run;

/* raw correlation between abortion and crime rates */

proc sort data=work.merged_states; by cohort_lag; run;
ods output PearsonCorr=work.corr_all;
proc corr data=work.eda; by cohort_lag;
  var abortionratetotal_100k birthrate_100k pregnancyrate_100k;
  with total_crime_rate violent_rate property_rate;
run;

data work.corr_long;
  set work.corr_all;
  length exposure $32;
  array p {*} Pabortionratetotal_100k Pbirthrate_100k Ppregnancyrate_100k;
  array nm {3} $32 _temporary_ ('Abortion rate' 'Birth rate' 'Pregnancy rate');
  do i = 1 to 3;
    exposure = nm{i};
    r = p{i};
    output;
  end;
  keep cohort_lag Variable exposure r;
  rename Variable = outcome;
run;

proc print data=work.corr_long noobs; 
run;

