/* Restrict time period and shift abortion year forward by the lag */
data abortions_clean;
    set abortions;
    where (1985 - &lag_years.) <= year <= (2020 - &lag_years.);
    cohort_year = year;

    if population1544 > 0 then
        abortionratetotal_100k = (abortionstotal / population1544) * 100000;

    state = upcase(strip(state));
    year  = year + &lag_years.;
run;

data crime_rates;
    set crimes;
    total_crime      = Data.Totals.Property.All + Data.Totals.Violent.All;
    total_crime_rate = Data.Rates.Property.All  + Data.Rates.Violent.All;
run;

data crimes_clean;
    length state $2 year 8 orig_state_clean $50;
    set crime_rates(rename=(state=orig_state year=orig_year));

