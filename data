```

```{r}
crime_clean %>%
  summarise(
    total_check = max(abs(Total - (Violent + Property))),
    violent_check = max(abs(Violent -
      (Murder + Forcible_Rape + Robbery + Aggravated_assault)))
  )
```

```{r}
ggplot(crime_clean, aes(x = Year, y = violent_crime_rate)) +
  geom_line() +
  geom_vline(xintercept = 1973, linetype = "dashed", color = "red") +
  labs(
    title = "U.S. Violent Crime Rate, 1960–2014",
    x = "Year",
    y = "Violent crimes per 100,000 people"
  ) +
  theme_minimal()
```
