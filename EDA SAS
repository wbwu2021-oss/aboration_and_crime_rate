%macro build_lags(lags);
    %local i lag;
    proc datasets library=work nolist; delete merged_all_lags; quit;

    %do i = 1 %to %sysfunc(countw(&lags));
        %let lag = %scan(&lags, &i);

        data ab_tmp;
            set abortions;
            where (1985 - &lag.) <= year <= (2020 - &lag.);
            cohort_year = year;
            if population1544 > 0 then
                abortionratetotal_100k = (abortionstotal / population1544) * 100000;
            state = upcase(strip(state));
            year  = year + &lag.;
        run;

        proc sort data=ab_tmp; by state year; run;

        data m_tmp;
            merge ab_tmp(in=a) crimes_clean(in=b);
            by state year;
            if b;
            cohort_lag = &lag.;
            missing_abortion = missing(abortionratetotal_100k);
        run;

        proc append base=merged_all_lags data=m_tmp force; run;
    %end;
%mend;

%build_lags(0 5 10 15 18 20)

